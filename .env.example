# Portfolio — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and should never be committed.

# ──────────────────────────────────────────
# Email (required for the contact form)
# Get a free API key at https://resend.com
# ──────────────────────────────────────────
RESEND_API_KEY=re_...

# ──────────────────────────────────────────
# Database (optional)
# When set, projects are served from PostgreSQL.
# When unset or pointing to a placeholder, static data in
# src/data/projects.ts is used automatically — no crash.
# ──────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@host:5432/portfolio

# ──────────────────────────────────────────
# Site URL (required in production)
# Used in OpenGraph metadata, sitemaps, and canonical links.
# No trailing slash.
# ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.dev
